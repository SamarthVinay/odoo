<odoo>
    <record id="view_routing_rule_list" model="ir.ui.view">
        <field name="name">routing.rule.list</field>
        <field name="model">routing.rule</field>
        <field name="arch" type="xml">
            <list string="Routing Rules">
                <field name="name"/>
                <field name="method_of_delivery"/>
                <field name="create_uid" string="Created By"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_routing_rule_form" model="ir.ui.view">
        <field name="name">routing.rule.form</field>
        <field name="model">routing.rule</field>
        <field name="arch" type="xml">
            <form string="Routing Rule">
                <sheet>
                    <field name="account_id" invisible="1"/>

                    <group>
                        <group>
                            <field name="name" placeholder="Enter Rule Name"/>
                            <field name="method_of_delivery"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Rule Conditions">
                            <field name="condition_ids" 
                                   widget="section_and_note_one2many"
                                   domain="[('account_id', '=', account_id)]">
                                <list string="Conditions">
                                    <field name="name"/>
                                    <field name="parameter"/> 
                                    <field name="create_uid"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <group string="Recipient Details">
                        <field name="recipient_to" widget="email" placeholder="e.g. email@domain.com"/>
                        <field name="recipient_cc" widget="email"/>
                    </group>

                    <group>
                        <group>
                            <field name="title"/>
                            <field name="company_name"/>
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="street"/>
                        </group>
                        <group>
                            <field name="street2"/>
                            
                            <field name="country_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="state_id" 
                                   domain="[('country_id', '=', country_id)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            
                            <field name="city"/>
                            <field name="zip_code"/>
                        </group>
                    </group>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div> -->
            </form>
        </field>
    </record>

    <record id="action_routing_rule" model="ir.actions.act_window">
        <field name="name">Routing Rules</field>
        <field name="res_model">routing.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
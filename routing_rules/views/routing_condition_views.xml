<odoo>
    <record id="view_routing_condition_tree" model="ir.ui.view">
        <field name="name">routing.condition.tree</field>
        <field name="model">routing.condition</field>
        <field name="arch" type="xml">
            <list string="Conditions">
                <field name="name"/>
                <field name="parameter"/>
                <field name="create_uid" string="Creator"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_routing_condition_form" model="ir.ui.view">
        <field name="name">routing.condition.form</field>
        <field name="model">routing.condition</field>
        <field name="arch" type="xml">
            <form string="Condition">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Jurisdiction Check"/></h1>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="account_id" readonly="1"/>
                            <field name="create_uid"/>
                            <field name="create_date"/>
                        </group>
                        <group string="Logic">
                            <field name="parameter"/>
                            <field name="operator"/>

                            <field name="value_entity_id"
                                   invisible="parameter != 'entity'"
                                   required="parameter == 'entity'"
                                   options="{'no_open': True, 'no_create': True}"/>

                            <field name="value_jurisdiction_id"
                                   invisible="parameter != 'jurisdiction'"
                                   required="parameter == 'jurisdiction'"
                                   options="{'no_open': True, 'no_create': True}"/>

                            <field name="value_case_type_id"
                                   invisible="parameter != 'case_type'"
                                   required="parameter == 'case_type'"
                                   options="{'no_open': True, 'no_create': True}"/>

                            <field name="value_doc_type"
                                   invisible="parameter != 'doc_type'"
                                   required="parameter == 'doc_type'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_routing_condition_all" model="ir.actions.act_window">
        <field name="name">All Conditions</field>
        <field name="res_model">routing.condition</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Condition!
            </p>
        </field>
    </record>

    <record id="action_routing_condition_filtered" model="ir.actions.act_window">
        <field name="name">Account Conditions</field>
        <field name="res_model">routing.condition</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('account_id', '=', active_id)]</field>
        <field name="context">{'default_account_id': active_id}</field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record id="property_list_view" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="garden_orientation"/>
            </list>
        </field>
    </record>

    <record id="property_form_view" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="postcode"/>
                        </group>
                        <group>
                            <field name="date_availability"/>
                            <field name="bedrooms"/>
                            <field name="garden"/>
                            <field name="garden_orientation"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
<record id="action_property" model="ir.actions.act_window">
<!--this is the field of the above model-->
<field name="name">Property</field>
<!-- #this is the model which is create in the model of the property-->
<field name="res_model">estate.property</field> 
<field name="view_mode">list,form</field>
<field name="help">This is the help of the above model</field>
</record>

</data>

</odoo>     
